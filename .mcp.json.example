{
  "mcpServers": {
    "你的记忆MCP": { "type": "http", "url": "https://<域名>/mcp" },
    "status": {
      "command": "node",
      "args": ["/src/status-mcp.js"],
      "env": { "STATUS_FILE": "/persona/status/now.json" }
    },
    "browser": {
      "type": "http",
      "url": "${BROWSER_MCP_URL}",
      "headers": { "X-Token": "${BROWSER_MCP_TOKEN}" }
    },
    "gmail": { "command": "npx", "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"] }
  }
}
